# Embed files into a C++ source as byte arrays, run with cmake -P:
#   cmake -DOUTPUT=out.cpp -DFILES="a.ttf|b.ttf" -P embed_files.cmake
# The source defines mt::embeddedFile(name), name is the file name without the folder (like "Hack-Regular.ttf").

string(REPLACE "|" ";" FILES "${FILES}")

set(content "// Generated by cmake/embed_files.cmake, do not edit\n#include \"embedded_files.h\"\n#include <cstring>\n\nnamespace mt {\n")
set(table "")
set(index 0)
foreach (file ${FILES})
    get_filename_component(name "${file}" NAME)
    file(READ "${file}" hex HEX)
    string(LENGTH "${hex}" length)
    math(EXPR size "${length} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
    # Break the lines so compilers and editors cope with the file
    string(REPEAT "0x..," 32 line)
    string(REGEX REPLACE "(${line})" "\\1\n" hex "${hex}")
    string(APPEND content "\tstatic const unsigned char file${index}[] = {\n${hex}\n};\n\n")
    string(APPEND table "\t\t\t{\"${name}\", file${index}, ${size}},\n")
    math(EXPR index "${index} + 1")
endforeach ()

string(APPEND content "\tEmbeddedFile embeddedFile(const char *name)\n\t{\n\t\tstatic const EmbeddedFile files[] = {\n${table}\t\t};\n")
string(APPEND content "\t\tfor (const auto &file : files)\n\t\t{\n\t\t\tif (std::strcmp(file.name, name) == 0)\n\t\t\t{\n\t\t\t\treturn file;\n\t\t\t}\n\t\t}\n\t\treturn {};\n\t}\n}\n")

file(WRITE "${OUTPUT}.tmp" "${content}")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")

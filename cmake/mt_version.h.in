#pragma once

// Generated by CMake from cmake/mt_version.h.in, the version comes from the latest v<x.y.z> git tag

/*! Numeric version, like 1.2.3 */
#define MT_VERSION_NUMBER "@MODELTOOL_VERSION@"

/*! Full version: 1.2.3 on the tagged commit, 1.2.3-<commits>-g<hash> after it */
#define MT_VERSION "@MODELTOOL_VERSION_FULL@"
